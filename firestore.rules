rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isPrincipalAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'autotecrastreio@gmail.com' ||
        request.auth.token.email.matches('(?i)^autotecrastreio@gmail\\.com$')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isPrincipalAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test doc for connection health check
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admins metadata collection (Write strictly restricted to Admins)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Company Settings (Read by all logged users; Modified strictly by Admins)
    match /company_settings/{settingsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(settingsId) &&
        incoming().companyName is string && incoming().companyName.size() <= 150;
    }

    // Users & Roles (RBAC: Operators cannot self-promote to Admin or alter active status)
    match /users/{userId} {
      allow read: if isSignedIn();
      // Operators can create their own profile as 'operator'; Admins can create any profile
      allow create: if isSignedIn() && isValidId(userId) && (
        (request.auth.uid == userId && (incoming().role == 'operator' || isAdmin())) ||
        isAdmin()
      );
      // Operators can update their profile (display name, photo) but CANNOT change role or active status
      allow update: if isSignedIn() && isValidId(userId) && (
        (request.auth.uid == userId && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'active'])) ||
        isAdmin()
      );
      // Only Admin can delete users (and cannot delete own profile)
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Commercial Plans & Packages (Managed exclusively by Admins; Operators only view & assign)
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(planId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().totalMonthlyValue is number && incoming().totalMonthlyValue >= 0 &&
        incoming().status in ['ativo', 'inativo'];
      allow delete: if isAdmin();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(clientId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().status in ['ativo', 'inativo'];
      allow update: if isSignedIn() && isValidId(clientId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().status in ['ativo', 'inativo'];
      allow delete: if isAdmin();
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(vehicleId) &&
        incoming().clientId is string && incoming().clientId.size() > 0 &&
        incoming().plate is string && incoming().plate.size() > 0 && incoming().plate.size() <= 15 &&
        incoming().vehicleType in ['carro', 'moto', 'caminhao', 'outro'] &&
        incoming().monthlyValue is number && incoming().monthlyValue >= 0 &&
        incoming().status in ['ativo', 'suspenso', 'cancelado'];
      allow update: if isSignedIn() && isValidId(vehicleId) &&
        incoming().clientId is string && incoming().clientId.size() > 0 &&
        incoming().plate is string && incoming().plate.size() > 0 && incoming().plate.size() <= 15 &&
        incoming().monthlyValue is number && incoming().monthlyValue >= 0 &&
        incoming().status in ['ativo', 'suspenso', 'cancelado'];
      allow delete: if isAdmin();
    }

    // Charges (Financial Integrity: Base monthly value & vehicle/client binding are immutable)
    match /charges/{chargeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(chargeId) &&
        incoming().clientId is string && incoming().vehicleId is string &&
        incoming().originalMonthlyValue is number && incoming().originalMonthlyValue >= 0 &&
        incoming().totalAmount is number && incoming().totalAmount >= 0 &&
        incoming().status in ['pendente', 'parcial', 'pago', 'cancelado'];
      allow update: if isSignedIn() && isValidId(chargeId) &&
        incoming().originalMonthlyValue == existing().originalMonthlyValue &&
        incoming().clientId == existing().clientId &&
        incoming().vehicleId == existing().vehicleId &&
        incoming().totalAmount is number && incoming().remainingBalance is number &&
        incoming().status in ['pendente', 'parcial', 'pago', 'cancelado'];
      // Can only delete if NO payments have been received yet (strictly enforces financial integrity)
      allow delete: if (isAdmin() || isSignedIn()) && existing().paidAmount == 0;
    }

    // Payments: Immutability invariant (NO delete, NO modification of historical amounts)
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(paymentId) &&
        incoming().chargeId is string && incoming().clientId is string &&
        incoming().amount is number && incoming().amount > 0 &&
        incoming().receiptNumber is string && incoming().receiptNumber.size() > 0 &&
        incoming().operatorId == request.auth.uid;
      allow update: if false; // Payments are strictly immutable
      allow delete: if false; // Deleting payments is forbidden for financial integrity
    }

    // Technical Services (Serviços Técnicos: Instalação, Retirada, Manutenção, Reinstalação)
    match /technical_services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(serviceId) &&
        incoming().orderNumber is string && incoming().orderNumber.size() > 0 &&
        incoming().clientId is string && incoming().totalAmount is number &&
        incoming().status in ['pendente', 'parcial', 'pago'];
      allow delete: if isAdmin();
    }

    // Technicians (Cadastro de Técnicos Responsáveis)
    match /technicians/{technicianId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(technicianId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150;
      allow delete: if isAdmin();
    }

    // Technical Service Types (Novos tipos de serviços técnicos)
    match /technical_service_types/{serviceTypeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(serviceTypeId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150;
      allow delete: if isAdmin();
    }

    // Expense Categories (Novos itens de despesas da empresa)
    match /expense_categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(categoryId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150;
      allow delete: if isAdmin();
    }

    // Fixed Expenses (Despesas Fixas e Recorrentes da Empresa)
    match /fixed_expenses/{fixedExpenseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(fixedExpenseId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 150 &&
        incoming().status in ['ativa', 'pausada', 'encerrada'];
      allow delete: if isAdmin();
    }

    // Company Expenses (Gastos da Empresa: Apoio, Chips, Sistema, Rastreadores, etc.)
    match /company_expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(expenseId) &&
        incoming().expenseNumber is string && incoming().expenseNumber.size() > 0 &&
        incoming().totalAmount is number &&
        incoming().status in ['pago', 'pendente', 'parcial'];
      allow delete: if isAdmin();
    }

    // Technician Payments (Controle de pagamentos realizados aos técnicos)
    match /technician_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(paymentId) &&
        incoming().technicianId is string &&
        incoming().amount is number && incoming().amount > 0;
      allow update: if (isAdmin() || isSignedIn()) && isValidId(paymentId);
      allow delete: if isAdmin();
    }

    // Audit logs: Append-only forensic trail
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().action is string && incoming().action.size() > 0 &&
        incoming().operatorId == request.auth.uid;
      allow update: if false; // Immutability
      allow delete: if false; // No deletion of logs under any circumstances
    }
  }
}
